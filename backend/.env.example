APP_NAME=ComplySmart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
# Use your MongoDB Atlas connection string here
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
DB_CONNECTION=mongodb
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DATABASE=complysmart

# ─── Redis (Queue + Cache) ────────────────────────────────────────────────────
# Set QUEUE_CONNECTION=sync if Redis is not available locally
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=cookie
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Broadcasting ─────────────────────────────────────────────────────────────
BROADCAST_DRIVER=log

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Tesseract OCR ────────────────────────────────────────────────────────────
# Path to the tesseract executable on your server
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac: tesseract (if on PATH)
TESSERACT_PATH=tesseract

# ─── Sanctum ─────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:3000,localhost:8000
SESSION_SAME_SITE=lax

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@complysmart.lk"
MAIL_FROM_NAME="${APP_NAME}"
