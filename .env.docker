# ComplySmart Docker Environment Variables

# Backend Overrides
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# MongoDB Connection
# To use local MongoDB container:
MONGODB_URI=mongodb://mongo:27017/complysmart
MONGODB_DATABASE=complysmart

# To use Atlas (uncomment and comment above):
# MONGODB_URI="mongodb+srv://afham2info_db_user:afham2004@cluster0.txrce71.mongodb.net/complysmart?retryWrites=true&w=majority&appName=Cluster0"
# MONGODB_DATABASE=complysmart

# JWT Auth — pre-generated secret so entrypoint never has to generate it
JWT_SECRET=25iviBkovzFYrMVueHAFK+X0LqLVaH3bKbVv1pLP5p4/3B7O3PSVf6PCq3gSAwco
JWT_TTL=525600

# Queue — use MongoDB database driver so OCR jobs run async (not blocking upload)
QUEUE_CONNECTION=database

# Sanctum stateful domains (include frontend for browser requests)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:5173,localhost:5174,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173,127.0.0.1:5174

# Redis Connection (if using local redis container, else keep as is)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Google Gemini AI (set GEMINI_API_KEY in backend/.env)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=30
GEMINI_MAX_HISTORY=10
